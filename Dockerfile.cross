# Multi-stage build: compile Rust for linux/arm64, then create runtime image.
# Used for local development builds. Every base is pinned by digest, as in the
# release Dockerfile (#36).
FROM --platform=linux/arm64 rust:trixie@sha256:e84068000361bf3d4a5ba2b7647f62893528b1eb9f847d7a23b493f5ce8ea254 AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    protobuf-compiler \
    libprotobuf-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY target/generated-sources/model ./target/generated-sources/model

# Remove any pre-compiled artifacts that are wrong architecture.
RUN find target/generated-sources/model/target -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true

# Build the release binary.
RUN cargo build --release

# ---- Runtime image ----
# The public base, as in the release Dockerfile.
FROM --platform=linux/arm64 debian:trixie-slim@sha256:8aa5a7bf5a1955bddbe7d74fcdd0b91ab30e74362a8b73af672b0481b35b44a0

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION

LABEL org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.authors="Jody Scott <jody@thescottsweb.com>" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.vendor="tacplus.dev" \
      org.opencontainers.image.title="OAuth" \
      org.opencontainers.image.description="Session management service for Schematic control plane"

COPY --from=builder /build/target/release/oauth /usr/local/bin/oauth
RUN chmod +x /usr/local/bin/oauth

ENTRYPOINT ["oauth"]
