# Multi-stage build: compile Rust for linux/arm64, then create runtime image.
# Used for local development builds.
FROM --platform=linux/arm64 rust:bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    protobuf-compiler \
    libprotobuf-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY target/generated-sources/tacplus ./target/generated-sources/tacplus

# Remove any pre-compiled artifacts that are wrong architecture.
RUN find target/generated-sources/tacplus/target -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true

# Build the release binary.
RUN cargo build --release

# ---- Runtime image ----
# The public base, as in the release Dockerfile.
FROM --platform=linux/arm64 debian:trixie-slim

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION

LABEL org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.authors="Jody Scott <jody@thescottsweb.com>" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.vendor="tacplus.dev" \
      org.opencontainers.image.title="OAuth" \
      org.opencontainers.image.description="Session management service for Schematic control plane"

COPY --from=builder /build/target/release/oauth /usr/local/bin/oauth
RUN chmod +x /usr/local/bin/oauth

ENTRYPOINT ["oauth"]
