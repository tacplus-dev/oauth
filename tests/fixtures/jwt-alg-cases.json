{
  "about": "Shared JWT alg-selection cases (oauth#4). The accepted set is built from the key (kty/crv), narrowed to the key's declared alg or, when it has none, to the provider's id_token_signing_alg_values_supported; none and HMAC are never in it. Every test signs each case as described here and must reach the stated expect. The keys are generated by each test run, never committed (oauth#26): see keys.",
  "claims": {
    "iss": "https://idp.example.com",
    "aud": "client-id",
    "sub": "subject",
    "exp": "now + 3600"
  },
  "sign": {
    "RS256|RS384|RS512": "RSASSA-PKCS1-v1_5 over header.payload with keys.rsa and that hash",
    "ES256": "ECDSA P-256 / SHA-256 with keys.ec, raw r||s",
    "EdDSA": "Ed25519 with keys.okp",
    "HSnnn:<secret>": "HMAC-SHA-nnn keyed with the bytes of hmac_secrets.<secret>",
    "empty": "header.payload. (empty third part)",
    "absent": "header.payload (two parts)"
  },
  "keys": {
    "about": "Fresh throwaway keys each test run generates before signing any case; no private key is committed. Each jwks entry names the key whose public half it carries.",
    "rsa": "RSA, 2048 bits or more, exponent 65537",
    "ec": "ECDSA P-256",
    "okp": "Ed25519"
  },
  "hmac_secrets": {
    "rsa-pem": "keys.rsa's public key as an X.509 SubjectPublicKeyInfo PEM (64-column lines, LF, trailing newline)",
    "rsa-der": "keys.rsa's public key as SubjectPublicKeyInfo DER (raw bytes)",
    "rsa-n": "keys.rsa's JWK n: the modulus, big-endian without leading zeros, base64url without padding",
    "ec-pem": "keys.ec's public key as an X.509 SubjectPublicKeyInfo PEM (64-column lines, LF, trailing newline)",
    "ec-der": "keys.ec's public key as SubjectPublicKeyInfo DER (raw bytes)"
  },
  "jwks": [
    {
      "kid": "rsa-noalg",
      "kty": "RSA",
      "key": "rsa"
    },
    {
      "kid": "rsa-rs256",
      "alg": "RS256",
      "kty": "RSA",
      "key": "rsa"
    },
    {
      "kid": "ec-noalg",
      "kty": "EC",
      "crv": "P-256",
      "key": "ec"
    },
    {
      "kid": "ec-es256",
      "alg": "ES256",
      "kty": "EC",
      "crv": "P-256",
      "key": "ec"
    },
    {
      "kid": "okp-noalg",
      "kty": "OKP",
      "crv": "Ed25519",
      "key": "okp"
    }
  ],
  "cases": [
