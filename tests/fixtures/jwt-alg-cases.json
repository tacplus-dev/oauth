{
  "about": "Shared JWT alg-selection cases (oauth#4). The accepted set is built from the key (kty/crv), narrowed to the key's declared alg or, when it has none, to the provider's id_token_signing_alg_values_supported; none and HMAC are never in it. Every test signs each case as described here and must reach the stated expect. Throwaway keys; not secrets.",
  "claims": {
    "iss": "https://idp.example.com",
    "aud": "client-id",
    "sub": "subject",
    "exp": "now + 3600"
  },
  "sign": {
    "RS256|RS384|RS512": "RSASSA-PKCS1-v1_5 over header.payload with private_keys.rsa and that hash",
    "ES256": "ECDSA P-256 / SHA-256 with private_keys.ec, raw r||s",
    "EdDSA": "Ed25519 with private_keys.okp",
    "HSnnn:<secret>": "HMAC-SHA-nnn keyed with the bytes of hmac_secrets.<secret> (rsa-der/ec-der are base64url DER; the key is the decoded DER)",
    "empty": "header.payload. (empty third part)",
    "absent": "header.payload (two parts)"
  },
